def launch(args):
    try:
        subprocess.Popen(
            args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True
        )
        return True
    except (FileNotFoundError, PermissionError, OSError):
        return False

def show_message(parent, title, message):
    dialog = Gtk.MessageDialog(
        transient_for=parent, flags=Gtk.DialogFlags.MODAL,
        message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK,
        text=title
    )
    dialog.format_secondary_text(message)
    dialog.run()
    dialog.destroy()

def app_entries():
    roots = [Path("/usr/share/applications"), Path("/usr/local/share/applications")]
    entries = []
    for root in roots:
        if not root.exists():
            continue
        for desktop in sorted(root.glob("*.desktop")):
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                parser.read(desktop, encoding="utf-8")
                entry = parser["Desktop Entry"]
                if entry.get("NoDisplay", "false").lower() == "true":
                    continue
                entries.append((entry.get("Name", desktop.stem), entry.get("Exec", "")))
            except (KeyError, ValueError, OSError):
                continue
    return entries

def launch_desktop_app(search_term):
    term = search_term.lower()
    for name, command in app_entries():
        if term not in name.lower() or not command:
            continue
        try:
            args = [part for part in shlex.split(command) if not part.startswith("%")]
        except ValueError:
            continue
        if args and launch(args):
            return True
    return False

def steam_games():
    games = {}
    roots = [
        HOME / ".steam/steam/steamapps",
        HOME / ".steam/root/steamapps",
        HOME / ".local/share/Steam/steamapps",
    ]
    for root in roots:
        if not root.exists():
            continue
        for manifest in root.glob("appmanifest_*.acf"):
            try:
                data = manifest.read_text(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            appid = re.search(r'"appid"\s+"(\d+)"', data)
            name = re.search(r'"name"\s+"([^"]+)"', data)
            if appid and name and name.group(1).strip():
                games[appid.group(1)] = name.group(1).strip()
    return sorted([(name, appid) for appid, name in games.items()],
                  key=lambda item: item[0].lower())

def steam_cover(appid):
    roots = [
        HOME / ".steam/steam/appcache/librarycache",
        HOME / ".steam/root/appcache/librarycache",
        HOME / ".local/share/Steam/appcache/librarycache",
    ]
    suffixes = (
        "_header.jpg", "_library_600x900.jpg",
        "_capsule_616x353.jpg", "_library_hero.jpg"
    )
    for suffix in suffixes:
        for root in roots:
            candidate = root / (str(appid) + suffix)
            if candidate.is_file():
                return candidate
    return None

ROM_EXTENSIONS = {
    ".nes", ".unf", ".unif", ".fds", ".smc", ".sfc", ".swc",
    ".gb", ".gbc", ".gba", ".gen", ".md", ".smd", ".32x",
    ".bin", ".sms", ".gg", ".zip", ".7z"
}

def roms_in(folder=None, limit=None):
    root = ROM_ROOT / folder if folder else ROM_ROOT
    found = []
    if not root.exists():
        return []
    try:
        for path in root.rglob("*"):
            if path.is_file() and path.suffix.lower() in ROM_EXTENSIONS:
                try:
                    found.append((path.stat().st_mtime, path))
                except OSError:
                    pass
    except OSError:
        return []
    found.sort(key=lambda item: item[0], reverse=True)
    paths = [path for _, path in found]
    return paths[:limit] if limit else paths

def rom_system(path):
    try:
        return path.relative_to(ROM_ROOT).parts[0].lower()
    except (ValueError, IndexError):
        return path.parent.name.lower()

def launch_rom(path):
    if not launch(["/usr/local/bin/vulkanos-game-runtime", "launch", str(path)]):
        show_message(
            None, "VulkanOS Game Runtime",
            "Não foi possível iniciar este jogo. Confira se o core do sistema está instalado. "
            "Abra a página EMULADORES ou execute vulkanos-game-runtime scan para verificar a biblioteca."
        )

def open_folder(path):
    Path(path).mkdir(parents=True, exist_ok=True)
    if not launch(["thunar", str(path)]):
        show_message(None, "Arquivos", "O gerenciador de arquivos não está disponível.")

def count_roms(folder):
    return len(roms_in(folder))

def card_art(filename):
    path = CARD_ROOT / filename
    return path if path.is_file() else None

def image_from(path, fallback_icon="applications-games"):
    if path:
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), 280, 125, True)
            return Gtk.Image.new_from_pixbuf(pixbuf)
        except (GLib.Error, OSError):
            pass
    image = Gtk.Image.new_from_icon_name(fallback_icon, Gtk.IconSize.DIALOG)
    image.set_pixel_size(54)
    return image

class VulkanDashboard(Gtk.Window):
    def __init__(self):
        super().__init__(title="VulkanOS")
        self.set_default_size(1280, 720)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", self.on_destroy)
        self.page_names = {
            "library": "BIBLIOTECA",
            "emulators": "EMULADORES",
            "browser": "NAVEGADOR",
            "steam": "STEAM",
            "settings": "CONFIGURAÇÕES",
            "about": "SOBRE",
        }
        self.nav_buttons = {}
        self.page_tiles = {}
        self.active_page = "library"
        self.controller_fd = None
        self.controller_path = None
        self.controller_name = ""
        self.axis_values = {0: 0, 1: 0}
        self.is_fullscreen = True
        self.install_css()
        self.build_ui()
        self.refresh_status()
        GLib.timeout_add_seconds(4, self.refresh_status)
        GLib.timeout_add_seconds(1, self.update_clock)
        GLib.timeout_add(35, self.poll_controller)

    def install_css(self):
        provider = Gtk.CssProvider()
        background_uri = BACKGROUND.as_uri() if BACKGROUND.exists() else ""
        css = CSS.replace("__BACKGROUND__", background_uri).encode("utf-8")
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.get_style_context().add_class("root")
        self.add(root)

        windowbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        windowbar.get_style_context().add_class("windowbar")
        root.pack_start(windowbar, False, False, 0)
        title = Gtk.Label(label="VULKAN OS")
        title.get_style_context().add_class("window-title")
        windowbar.pack_start(title, False, False, 0)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        windowbar.pack_start(spacer, True, True, 0)
        for caption, style, callback in [
            ("—", "window-control", self.minimize_window),
            ("□", "window-control", self.toggle_fullscreen),
            ("×", "window-control window-close", self.close_dashboard),
        ]:
            button = Gtk.Button(label=caption)
            button.set_relief(Gtk.ReliefStyle.NONE)
            for css_class in style.split():
                button.get_style_context().add_class(css_class)
            button.connect("clicked", lambda _button, action=callback: action())
            windowbar.pack_end(button, False, False, 0)

        topbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        topbar.get_style_context().add_class("topbar")
        root.pack_start(topbar, False, False, 0)

        mark = Gtk.Label()
        mark.set_markup('<span foreground="#ed4055" weight="heavy" size="xx-large">◢</span>')
        topbar.pack_start(mark, False, False, 0)
        brand = Gtk.Label()
        brand.set_markup('<span weight="heavy" size="xx-large">VULKAN</span>')
        brand.get_style_context().add_class("brand")
        topbar.pack_start(brand, False, False, 0)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        topbar.pack_start(spacer, True, True, 0)

        self.battery_label = self.status_label("BATERIA --")
        topbar.pack_end(self.clock_label_widget(), False, False, 0)
        self.wifi_label = self.status_label("WI-FI --")
        topbar.pack_end(self.wifi_label, False, False, 0)
        topbar.pack_end(self.battery_label, False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        root.pack_start(body, True, True, 0)

        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sidebar.set_size_request(310, -1)
        sidebar.get_style_context().add_class("sidebar")
        body.pack_start(sidebar, False, False, 0)

        nav_items = [
            ("library", "BIBLIOTECA", "view-grid"),
            ("emulators", "EMULADORES", "applications-games"),
            ("browser", "NAVEGADOR", "web-browser"),
            ("steam", "STEAM", "applications-games"),
            ("settings", "CONFIGURAÇÕES", "applications-system"),
            ("about", "SOBRE", "dialog-information"),
        ]
        for key, label, icon in nav_items:
            button = Gtk.Button()
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.set_halign(Gtk.Align.FILL)
            button.get_style_context().add_class("nav-button")
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=13)
            image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
            image.set_pixel_size(29)
            text = Gtk.Label(label=label)
            text.set_xalign(0)
            text.get_style_context().add_class("nav-label")
            row.pack_start(image, False, False, 0)
            row.pack_start(text, True, True, 0)
            button.add(row)
            button.connect("clicked", lambda _button, page=key: self.switch_page(page))
            sidebar.pack_start(button, False, False, 0)
            self.nav_buttons[key] = button

        sidebar_spacer = Gtk.Box()
        sidebar_spacer.set_vexpand(True)
        sidebar.pack_start(sidebar_spacer, True, True, 0)
        side_brand = Gtk.Label()
        side_brand.set_markup(
            '<span weight="heavy" size="xx-large">VULKAN</span>'
            '<span foreground="#e84055" weight="heavy" size="xx-large"> OS</span>'
        )
        side_brand.set_xalign(0)
        side_brand.get_style_context().add_class("sidebar-brand")
        sidebar.pack_start(side_brand, False, False, 3)
        side_tools = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        gear = Gtk.Image.new_from_icon_name("preferences-system", Gtk.IconSize.BUTTON)
        shield = Gtk.Image.new_from_icon_name("security-high", Gtk.IconSize.BUTTON)
        side_tools.pack_start(gear, False, False, 2)
        side_tools.pack_start(shield, False, False, 2)
        sidebar.pack_start(side_tools, False, False, 6)

        main_area = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_area.get_style_context().add_class("main-area")
        body.pack_start(main_area, True, True, 0)

        device_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        device_row.set_halign(Gtk.Align.END)
        device_row.get_style_context().add_class("device-row")
        main_area.pack_start(device_row, False, False, 0)
        self.network_label = self.chip("CONEXÃO DE REDE: --")
        self.controller_label = self.chip("CONTROLADOR: --")
        self.bluetooth_label = self.chip("BLUETOOTH: --")
        for chip in (self.network_label, self.controller_label, self.bluetooth_label):
            device_row.pack_start(chip, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(110)
        main_area.pack_start(self.stack, True, True, 0)

        self.stack.add_named(self.build_page("library", self.build_library_page), "library")
        self.stack.add_named(self.build_page("emulators", self.build_emulators_page), "emulators")
        self.stack.add_named(self.build_page("browser", self.build_browser_page), "browser")
        self.stack.add_named(self.build_page("steam", self.build_steam_page), "steam")
        self.stack.add_named(self.build_page("settings", self.build_settings_page), "settings")
        self.stack.add_named(self.build_page("about", self.build_about_page), "about")
        self.switch_page("library")

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        footer.get_style_context().add_class("footer")
        root.pack_end(footer, False, False, 0)
        hints = Gtk.Label()
        hints.set_markup(
            '<span foreground="#4ecb78" weight="bold">A</span><span> SELECIONAR</span>'
            '    <span foreground="#f04d62" weight="bold">B</span><span> VOLTAR</span>'
            '    <span foreground="#57a9e9" weight="bold">X</span><span> DETALHES</span>'
            '    <span foreground="#f2d34d" weight="bold">Y</span><span> PESQUISAR</span>'
            '    <span weight="bold">START</span><span> MENU DE SISTEMA</span>'
        )
        hints.get_style_context().add_class("footer-text")
        footer.pack_end(hints, False, False, 8)

    def status_label(self, text):
        label = Gtk.Label(label=text)
        label.get_style_context().add_class("top-status")
        return label

    def clock_label_widget(self):
        self.clock_label = Gtk.Label(label="--:--")
        self.clock_label.get_style_context().add_class("clock")
        return self.clock_label

    def chip(self, text):
        label = Gtk.Label(label=text)
        label.get_style_context().add_class("device-chip")
        return label

    def make_page(self):
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.set_margin_start(9)
        page.set_margin_end(9)
        page.set_margin_top(10)
        page.set_margin_bottom(20)
        page.get_style_context().add_class("content")
        scroll.add(page)
        return scroll, page

    def add_heading(self, page, title, subtitle=None):
        heading = Gtk.Label(label=title)
        heading.set_xalign(0)
        heading.get_style_context().add_class("page-title")
        page.pack_start(heading, False, False, 0)
        if subtitle:
            sub = Gtk.Label(label=subtitle)
            sub.set_xalign(0)
            sub.get_style_context().add_class("muted")
            page.pack_start(sub, False, False, 0)

    def make_tile(self, title, subtitle, icon, callback, color="tile-red", image_path=None):
        button = Gtk.Button()
        button.set_size_request(-1, 155)
        button.set_hexpand(True)
        button.set_halign(Gtk.Align.FILL)
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_tooltip_text(title + " — " + subtitle)
        context = button.get_style_context()
        context.add_class("tile")
        context.add_class(color)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        art = image_from(image_path, icon)
        art.set_hexpand(True)
        art.set_vexpand(True)
        art.set_halign(Gtk.Align.FILL)
        art.set_valign(Gtk.Align.FILL)
        art.set_size_request(-1, 125)
        art.get_style_context().add_class("tile-art")
        box.pack_start(art, True, True, 0)

        caption = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        caption.get_style_context().add_class("tile-caption")
        name = Gtk.Label(label=title)
        name.set_xalign(0)
        name.set_ellipsize(3)
        name.get_style_context().add_class("tile-title")
        detail = Gtk.Label(label=subtitle)
        detail.set_xalign(1)
        detail.set_ellipsize(3)
        detail.get_style_context().add_class("tile-subtitle")
        caption.pack_start(name, True, True, 0)
        caption.pack_end(detail, False, False, 0)
        box.pack_end(caption, False, False, 0)

        button.add(box)
        button.connect("clicked", lambda *_: callback())
        return button

    def add_section(self, page, title, cards, note=None):
        heading = Gtk.Label(label=title)
        heading.set_xalign(0)
        heading.get_style_context().add_class("section-title")
        page.pack_start(heading, False, False, 0)
        grid = Gtk.Grid()
        grid.set_column_spacing(15)
        grid.set_row_spacing(14)
        grid.set_column_homogeneous(True)
        grid.set_hexpand(True)
        page_buttons = self.page_tiles.setdefault(self._building_page, [])
        for index, card in enumerate(cards):
            button = self.make_tile(*card)
            grid.attach(button, index % 3, index // 3, 1, 1)
            page_buttons.append(button)
        if cards:
            page.pack_start(grid, False, False, 0)
        if note:
            label = Gtk.Label(label=note)
            label.set_xalign(0)
            label.get_style_context().add_class("muted")
            page.pack_start(label, False, False, 0)

    def build_page(self, key, builder):
        self._building_page = key
        result = builder()
        self._building_page = None
        self.page_tiles.setdefault(key, [])
        return result

    def open_system_folder(self, folder):
        files = roms_in(folder, 1)
        if files:
            launch_rom(files[0])
        else:
            open_folder(ROM_ROOT / folder)

    def build_library_page(self):
        scroll, page = self.make_page()
        self.add_heading(page, "BIBLIOTECA")
        games = steam_games()
        game_cards = []
        for name, appid in games[:3]:
            game_cards.append((
                name, "Steam", "applications-games",
                lambda appid=appid: launch(["steam", "-applaunch", appid]),
                "tile-red", steam_cover(appid)
            ))
        if not game_cards:
            game_cards.append((
                "STEAM", "Abrir biblioteca de jogos", "applications-games",
                lambda: launch(["steam", "-gamepadui"]), "tile-blue", None
            ))
        self.add_section(page, "JOGOS INSTALADOS", game_cards,
                         "Os jogos aparecem aqui depois de instalados na Steam.")

        favorites = [
            ("SUPER NINTENDO", "SNES • " + str(count_roms("snes")) + " jogos",
             "applications-games", lambda: self.open_system_folder("snes"),
             "tile-blue", card_art("snes.svg")),
            ("MEGA DRIVE", "SEGA • " + str(count_roms("megadrive")) + " jogos",
             "applications-games", lambda: self.open_system_folder("megadrive"),
             "tile-purple", card_art("megadrive.svg")),
            ("RETROARCH", "Pronto para jogar", "applications-games",
             lambda: launch(["retroarch"]), "tile-red", card_art("retroarch.svg")),
        ]
        self.add_section(page, "FAVORITOS", favorites)

        recents = roms_in(limit=3)
        recent_cards = [
            (path.stem, "ROM • " + rom_system(path).upper(), "applications-games",
             lambda path=path: launch_rom(path), "tile-green", None)
            for path in recents
        ]
        if not recent_cards:
            recent_cards = [
                ("ADICIONE JOGOS", "Copie ROMs para ~/ROMs", "folder",
                 lambda: open_folder(ROM_ROOT), "tile-green", None)
            ]
        self.add_section(page, "RECENTES", recent_cards)
        return scroll

    def build_emulators_page(self):
