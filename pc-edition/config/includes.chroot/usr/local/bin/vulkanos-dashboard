    def build_about_page(self):
        scroll, page = self.make_page()
        self.add_heading(page, "SOBRE O VULKANOS", "PC Edition • Alpha")
        label = Gtk.Label()
        label.set_xalign(0)
        label.set_line_wrap(True)
        label.set_markup(
            "<b>VulkanOS PC Alpha</b>\n\n"
            "Uma experiência Linux focada em jogos, com interface de console e ambiente desktop XFCE.\n\n"
            "<b>Inclui:</b> Steam, RetroArch, ES-DE, Hydra Launcher, Firefox ESR, AntiMicro e suporte Mesa/Vulkan.\n\n"
            "<b>Estado:</b> interface experimental. A navegação por controle usa a interface joystick do Linux "
            "quando o dispositivo está disponível; compatibilidade ainda depende do hardware."
        )
        label.get_style_context().add_class("muted")
        page.pack_start(label, False, False, 8)
        return scroll

    def switch_page(self, name):
        if name not in self.page_names:
            return
        self.active_page = name
        self.stack.set_visible_child_name(name)
        for key, button in self.nav_buttons.items():
            context = button.get_style_context()
            if key == name:
                context.add_class("active")
            else:
                context.remove_class("active")

    def refresh_status(self):
        network_text = "SEM REDE"
        wifi_text = "WI-FI DESCONECTADO"
        try:
            result = subprocess.run(
                ["nmcli", "-t", "-f", "TYPE,STATE", "device"],
                capture_output=True, text=True, timeout=2
            )
            lines = [line.lower() for line in result.stdout.splitlines()]
            wifi_connected = any(
                line.startswith(("wifi:connected", "802-11-wireless:connected"))
                for line in lines
            )
            ethernet_connected = any(
                line.startswith(("ethernet:connected", "802-3-ethernet:connected"))
                for line in lines
            )
            if ethernet_connected:
                network_text = "CABO (GIGABIT)"
            elif wifi_connected:
                network_text = "WI-FI"
            wifi_text = "WI-FI CONECTADO" if wifi_connected else "WI-FI DESCONECTADO"
        except (OSError, subprocess.TimeoutExpired):
            pass

        devices = sorted(glob.glob("/sys/class/input/js*/device/name"))
        if devices:
            try:
                self.controller_name = Path(devices[0]).read_text(
                    encoding="utf-8", errors="ignore"
                ).strip()
            except OSError:
                self.controller_name = "GAMEPAD"
            controller_text = "CONECTADO (" + self.controller_name[:22] + ")"
        else:
            self.controller_name = ""
            controller_text = "NÃO CONECTADO"

        try:
            result = subprocess.run(
                ["systemctl", "is-active", "bluetooth"],
                capture_output=True, text=True, timeout=2
            )
            bt_text = "ATIVO" if result.stdout.strip() == "active" else "INATIVO"
        except (OSError, subprocess.TimeoutExpired):
            bt_text = "--"

        batteries = glob.glob("/sys/class/power_supply/BAT*/capacity")
        battery_text = "--"
        if batteries:
            try:
                battery_text = Path(batteries[0]).read_text().strip() + "%"
            except OSError:
                pass

        self.network_label.set_text("CONEXÃO DE REDE: " + network_text)
        self.controller_label.set_text("CONTROLADOR: " + controller_text)
        self.bluetooth_label.set_text("BLUETOOTH: " + bt_text)
        self.wifi_label.set_markup(
            '<span foreground="#ece9ed" size="x-large">)))</span>  '
            + GLib.markup_escape_text(wifi_text)
        )
        self.battery_label.set_markup(
            '<span foreground="#53d17b" size="x-large">▰</span>  '
            + GLib.markup_escape_text(battery_text)
        )
        return True

    def update_clock(self):
        from datetime import datetime
        self.clock_label.set_text(datetime.now().strftime("%H:%M"))
        return True

    def focus_nav(self):
        button = self.nav_buttons.get(self.active_page)
        if button:
            button.grab_focus()

    def focus_first_tile(self):
        tiles = self.page_tiles.get(self.active_page, [])
        if tiles:
            tiles[0].grab_focus()
        else:
            self.focus_nav()

    def move_focus(self, direction):
        focused = self.get_focus()
        nav_items = list(self.nav_buttons.items())
        focused_nav = next((key for key, button in nav_items if button == focused), None)
        directions = {
            "UP": Gtk.DirectionType.UP,
            "DOWN": Gtk.DirectionType.DOWN,
            "LEFT": Gtk.DirectionType.LEFT,
            "RIGHT": Gtk.DirectionType.RIGHT,
        }
        if focused_nav is not None:
            keys = [key for key, _ in nav_items]
            index = keys.index(focused_nav)
            if direction == "UP" and index > 0:
                self.nav_buttons[keys[index - 1]].grab_focus()
                return
            if direction == "DOWN" and index < len(keys) - 1:
                self.nav_buttons[keys[index + 1]].grab_focus()
                return
            if direction == "RIGHT":
                tiles = self.page_tiles.get(self.active_page, [])
                if tiles:
                    tiles[0].grab_focus()
                    return
        elif direction == "LEFT":
            self.focus_nav()
            return
        self.child_focus(directions[direction])

    def focused_button(self):
        widget = self.get_focus()
        while widget is not None and not isinstance(widget, Gtk.Button):
            widget = widget.get_parent()
        return widget

    def select_focused(self):
        button = self.focused_button()
        if button is not None:
            button.clicked()
        else:
            tiles = self.page_tiles.get(self.active_page, [])
            if tiles:
                tiles[0].clicked()
            else:
                self.nav_buttons[self.active_page].clicked()

    def show_details(self):
        button = self.focused_button()
        detail = button.get_tooltip_text() if button else "VulkanOS PC Alpha"
        show_message(self, "DETALHES", detail or "VulkanOS PC Alpha")

    def show_search(self):
        dialog = Gtk.Dialog(
            title="Pesquisar na biblioteca", transient_for=self,
            flags=Gtk.DialogFlags.MODAL
        )
        dialog.add_button("VOLTAR", Gtk.ResponseType.CANCEL)
        dialog.add_button("PESQUISAR", Gtk.ResponseType.OK)
        entry = Gtk.Entry()
        entry.set_placeholder_text("Digite o nome de um jogo ou ROM...")
        entry.set_activates_default(True)
        dialog.get_content_area().set_spacing(10)
        dialog.get_content_area().pack_start(entry, True, True, 15)
        dialog.set_default_response(Gtk.ResponseType.OK)
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK:
            query = entry.get_text().strip().lower()
            if query:
                matches = [name for name, _ in steam_games() if query in name.lower()]
                matches += [path.name for path in roms_in(limit=300) if query in path.name.lower()]
                result = "\n".join(matches[:20]) if matches else "Nenhum resultado encontrado."
                show_message(self, "RESULTADOS", result)
        dialog.destroy()

    def show_system_menu(self):
        dialog = Gtk.MessageDialog(
            transient_for=self, flags=Gtk.DialogFlags.MODAL,
            message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
            text="MENU DE SISTEMA"
        )
        dialog.format_secondary_text(
            "Voltar para o desktop XFCE ou continuar na interface VulkanOS?"
        )
        dialog.add_button("CONTINUAR", Gtk.ResponseType.CANCEL)
        dialog.add_button("DESKTOP XFCE", Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.close_dashboard()

    def close_dashboard(self):
        self.destroy()

    def minimize_window(self):
        Gtk.Window.iconify(self)

    def on_destroy(self, *_args):
        if Gtk.main_level() > 0:
            Gtk.main_quit()

    def toggle_fullscreen(self):
        if self.is_fullscreen:
            self.unfullscreen()
        else:
            self.fullscreen()
        self.is_fullscreen = not self.is_fullscreen

    def on_key(self, _widget, event):
        key = Gdk.keyval_name(event.keyval)
        if key in ("Return", "KP_Enter", "space"):
            self.select_focused()
            return True
        if key == "Escape":
            if self.active_page != "library":
                self.switch_page("library")
                self.focus_nav()
            return True
        if key in ("Left", "Right", "Up", "Down"):
            self.move_focus(key.upper())
            return True
        if key.lower() == "x":
            self.show_details()
            return True
        if key.lower() == "y":
            self.show_search()
            return True
        if key == "F10":
            self.show_system_menu()
            return True
        if key == "F11":
            self.toggle_fullscreen()
            return True
        return False

    def perform_gamepad_button(self, number):
        if number == 0:
            self.select_focused()
        elif number == 1:
            if self.active_page != "library":
                self.switch_page("library")
                self.focus_nav()
        elif number == 2:
            self.show_details()
        elif number == 3:
            self.show_search()
        elif number == 9:
            self.show_system_menu()

    def poll_controller(self):
        if self.controller_fd is None:
            candidates = sorted(glob.glob("/dev/input/js*"))
            if candidates:
                try:
                    self.controller_path = candidates[0]
                    self.controller_fd = os.open(
                        self.controller_path, os.O_RDONLY | os.O_NONBLOCK
                    )
                except OSError:
                    self.controller_fd = None

        if self.controller_fd is not None:
            try:
                while True:
                    raw = os.read(self.controller_fd, 8)
                    if len(raw) != 8:
                        break
                    _timestamp, value, event_type, number = struct.unpack("IhBB", raw)
                    event_type &= 0x7F
                    if event_type == 0x02 and number in (0, 1):
                        old = self.axis_values[number]
                        self.axis_values[number] = value
                        threshold = 18000
                        if abs(old) < threshold <= abs(value):
                            if number == 0:
                                self.move_focus("RIGHT" if value > 0 else "LEFT")
                            else:
                                self.move_focus("DOWN" if value > 0 else "UP")
                    elif event_type == 0x01 and value == 1:
                        self.perform_gamepad_button(number)
            except BlockingIOError:
                pass
            except OSError:
                try:
                    os.close(self.controller_fd)
                except OSError:
                    pass
                self.controller_fd = None
                self.controller_path = None
        return True

    def finish_smoke_test(self):
        screenshot_path = os.environ.get("VULKANOS_SCREENSHOT_PATH")
        if screenshot_path:
            try:
                gdk_window = self.get_window()
                if gdk_window is None:
                    raise RuntimeError("GTK dashboard window was not realized")
                width, height = self.get_size()
                pixbuf = Gdk.pixbuf_get_from_window(gdk_window, 0, 0, width, height)
                if pixbuf is None:
                    raise RuntimeError("Could not capture the GTK dashboard")
                Path(screenshot_path).parent.mkdir(parents=True, exist_ok=True)
                pixbuf.savev(screenshot_path, "png", [], [])
                print("VULKANOS_SCREENSHOT=" + screenshot_path, flush=True)
            except Exception as error:
                self.smoke_test_error = str(error)
        Gtk.main_quit()
        return GLib.SOURCE_REMOVE

    def run_smoke_test(self):
        self.smoke_test_error = None
        for page in self.page_names:
            self.switch_page(page)
        self.switch_page("library")
        self.show_all()
        self.fullscreen()
        self.focus_first_tile()
        GLib.timeout_add(900, self.finish_smoke_test)

def main():
    smoke_test = "--smoke-test" in sys.argv
    window = VulkanDashboard()
    window.show_all()
    if smoke_test:
        window.run_smoke_test()
        Gtk.main()
        smoke_test_error = window.smoke_test_error
        window.destroy()
        if smoke_test_error:
            print("VulkanOS dashboard smoke test failed: " + smoke_test_error, file=sys.stderr)
            return 1
        return 0
    window.is_fullscreen = True
    window.fullscreen()
    window.focus_first_tile()
    Gtk.main()
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
