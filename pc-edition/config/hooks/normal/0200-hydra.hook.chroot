#!/bin/sh
set -eu
export DEBIAN_FRONTEND=noninteractive

# Pin the verified official Linux amd64 release asset.
# This avoids depending on the unauthenticated GitHub Releases API,
# which can be rate-limited on shared CI runners.
HYDRA_VERSION="4.4.1"
HYDRA_DEB="/tmp/hydralauncher_"$HYDRA_VERSION"_amd64.deb"
HYDRA_URL="https://github.com/hydralauncher/hydra/releases/download/v$HYDRA_VERSION/$(basename "$HYDRA_DEB")"
HYDRA_SHA256="0527fe3fec945b3463f14d7b61a6ff12f76215b9e5d3ba338a677d0c20c92cb8"

curl -fL --retry 4 --retry-delay 2 --connect-timeout 30 \
  "$HYDRA_URL" -o "$HYDRA_DEB"

echo "$HYDRA_SHA256  $HYDRA_DEB" | sha256sum --check -

apt-get update
apt-get install -y --no-install-recommends "$HYDRA_DEB"
rm -f "$HYDRA_DEB"
rm -rf /var/lib/apt/lists/*
